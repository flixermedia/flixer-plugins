{
    "manifestVersion": 1,
    "id": "flixer.official",
    "name": "Official Flixer Plugins",
    "description": "Official, independently versioned extensions maintained by the Flixer project.",
    "plugins": [
        {
            "id": "flixer.example",
            "name": "Flixer Example Plugin",
            "description": "Demonstrates an authenticated WASI backend route, permission-scoped persistent storage and permissioned host HTTP calls.",
            "author": "Flixer",
            "capabilities": [
                "api.routes",
                "backend.storage",
                "network.http"
            ],
            "permissions": [
                "api.routes.hello",
                "api.routes.fetch",
                "network.http.example.com",
                "storage.plugin.read",
                "storage.plugin.write",
                "storage.user.read",
                "storage.user.write"
            ],
            "targets": [
                "flixer"
            ],
            "versions": [
                {
                    "version": "1.0.0",
                    "manifest": "plugins/example/1.0.0/plugin.json",
                    "package": "plugins/example/1.0.0/package.tar.gz",
                    "sha256": "923d0616bfa1cceeadd4e8a17eb208a2f357ba0aef6b4f4d4d7e3b36420870d6",
                    "size": 939190
                },
                {
                    "version": "1.1.0",
                    "manifest": "plugins/example/1.1.0/plugin.json",
                    "package": "plugins/example/1.1.0/package.tar.gz",
                    "sha256": "8f77550c9e7febda7fbead41b68c5597657901ccdc8bf8669ef60a76581abfe6",
                    "size": 941153
                }
            ]
        },
        {
            "id": "flixer.skipmedb",
            "name": "SkipMe.db",
            "description": "SkipMe.db segment integration for Flixer: crowd-sourced intro, recap, credits and preview timestamps.",
            "author": "Flixer",
            "capabilities": [
                "media.segments",
                "network.http"
            ],
            "permissions": [
                "media.segments.lookup",
                "network.http.database.skipme.deno.net"
            ],
            "targets": [
                "flixer"
            ],
            "versions": [
                {
                    "version": "1.0.0",
                    "manifest": "plugins/skipmedb/1.0.0/plugin.json",
                    "package": "plugins/skipmedb/1.0.0/package.tar.gz",
                    "sha256": "86b6a5bcac8a920205c3a4224c8f442c360225f556877288c1eea5435f11540b",
                    "size": 1118644
                },
                {
                    "version": "1.1.1",
