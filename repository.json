                    "package": "plugins/skipmedb/1.1.1/package.tar.gz",
                    "sha256": "623634b8e6f0c680eac688562f77bb82bcbae57897a46a0aeba7cd4b0895def8",
                    "size": 1118773
                }
            ]
        }
    ]
}
