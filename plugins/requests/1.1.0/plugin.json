{
    "manifestVersion": 1,
    "id": "flixer.requests",
    "name": "Requests",
    "version": "1.1.0",
    "description": "Discover movies, series and albums, request them, and send approved requests to Sonarr, Radarr and Lidarr.",
    "author": "Flixer",
    "license": "MIT",
    "homepage": "https://github.com/flixermedia/flixer-plugins/tree/main/plugins/requests",
    "compatibility": {
        "pluginApi": "^1.0.0"
    },
    "targets": {
        "flixer": {
            "entry": "backend/plugin.wasm"
        }
    },
    "capabilities": [
        "api.routes",
        "schedule",
        "ui.pages",
        "network.http",
        "database.tables",
        "secrets",
        "users",
        "library",
        "notifications",
        "search.results"
    ],
    "permissions": [
        "api.routes.page",
        "api.routes.request",
        "api.routes.cancel",
        "api.routes.approve",
        "api.routes.retry",
        "api.routes.decline",
        "api.routes.service-save",
        "api.routes.service-delete",
        "api.routes.service-test",
        "api.routes.user-limit-save",
        "api.routes.settings-save",
        "api.routes.search",
        "api.routes.sync",
        "database.tables",
        "secrets.manage",
        "users.read",
        "library.read",
        "notifications.send",
        "schedule.run",
        "settings.read",
        "network.http.any"
    ],
    "database": {
        "tables": {
            "requests": {
                "columns": {
                    "id": { "type": "uuid", "primary": true },
                    "user_id": { "type": "uuid", "nullable": false },
                    "type": { "type": "text", "nullable": false },
                    "source": { "type": "text", "nullable": false },
                    "external_id": { "type": "text", "nullable": false },
                    "title": { "type": "text", "nullable": false },
                    "year": { "type": "integer", "nullable": true },
                    "poster": { "type": "text", "nullable": true },
                    "artist": { "type": "text", "nullable": true },
                    "seasons": { "type": "json", "nullable": true },
                    "status": { "type": "text", "nullable": false, "default": "pending" },
                    "service_id": { "type": "uuid", "nullable": true },
                    "quality_profile_id": { "type": "integer", "nullable": true },
                    "root_folder": { "type": "text", "nullable": true },
                    "decline_reason": { "type": "text", "nullable": true },
                    "error": { "type": "text", "nullable": true },
                    "processed_by": { "type": "uuid", "nullable": true },
                    "tvdb_id": { "type": "integer", "nullable": true },
                    "send_attempts": { "type": "integer", "nullable": true },
                    "created_at": { "type": "timestamp", "nullable": false },
                    "updated_at": { "type": "timestamp", "nullable": false }
                },
                "indexes": [
                    { "columns": ["user_id", "created_at"] },
                    { "columns": ["type", "external_id"] },
                    { "columns": ["status", "created_at"] }
                ]
            },
            "services": {
                "columns": {
                    "id": { "type": "uuid", "primary": true },
                    "kind": { "type": "text", "nullable": false },
                    "name": { "type": "text", "nullable": false },
                    "url": { "type": "text", "nullable": false },
                    "is_default": { "type": "boolean", "nullable": false, "default": false },
                    "enabled": { "type": "boolean", "nullable": false, "default": false },
                    "root_folder": { "type": "text", "nullable": false, "default": "" },
                    "quality_profile_id": { "type": "integer", "nullable": false, "default": 0 },
                    "metadata_profile_id": { "type": "integer", "nullable": true },
                    "language_profile_id": { "type": "integer", "nullable": true },
                    "minimum_availability": { "type": "text", "nullable": true },
                    "season_folders": { "type": "boolean", "nullable": false, "default": true },
                    "tags": { "type": "json", "nullable": true },
                    "created_at": { "type": "timestamp", "nullable": false }
                },
                "indexes": [
                    { "columns": ["kind"] }
                ]
            },
            "settings": {
                "columns": {
                    "key": { "type": "text", "primary": true },
                    "value": { "type": "json", "nullable": true }
                }
            },
            "user_limits": {
                "columns": {
                    "user_id": { "type": "uuid", "primary": true },
                    "can_request": { "type": "boolean", "nullable": true },
                    "auto_approve": { "type": "boolean", "nullable": true },
                    "quota_limit": { "type": "integer", "nullable": true },
                    "quota_days": { "type": "integer", "nullable": true }
                }
            }
        }
    },
    "schedules": [
        { "operation": "sync", "intervalSeconds": 300 }
    ],
    "ui": {
        "pages": [
            { "id": "requests", "title": "Requests", "nav": "main" }
        ]
    }
}
